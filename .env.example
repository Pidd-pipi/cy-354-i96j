# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=lpcampusmarket

# 数据库
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd

# JWT 签名密钥（生产环境请替换为长随机串）
JWT_SECRET=change_me_to_a_long_random_string

# 端口映射（本地冲突时可调整）
FRONTEND_PORT=28514
BACKEND_PORT=29514
DB_PORT=3306
